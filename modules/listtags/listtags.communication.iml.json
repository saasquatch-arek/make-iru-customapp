{
	"url": "/tags",
	"method": "GET",
	"qs": {
		"search": "{{parameters.search}}"
	},
	"response": {
		"iterate": "{{body.results}}",
		"output": {
			"id": "{{item.id}}",
			"tag_id": "{{item.id}}",
			"name": "{{item.name}}",
			"color": "{{item.color}}",
			"device_count": "{{item.device_count}}",
			"body": "{{item}}"
		},
		"limit": "{{parameters.limit}}"
	},
	"pagination": {
		"mergeWithParent": false,
		"condition": "{{body.next}}",
		"url": "{{body.next}}"
	}
}
