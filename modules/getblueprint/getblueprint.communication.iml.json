{
	"url": "/blueprints/{{parameters.blueprintId}}/",
	"method": "GET",
	"response": {
		"output": {
			"id": "{{body.id}}",
			"name": "{{body.name}}",
			"icon": "{{body.icon}}",
			"color": "{{body.color}}",
			"description": "{{body.description}}",
			"params": "{{body.params}}",
			"computers_count": "{{body.computers_count}}",
			"missing_computers_count": "{{body.missing_computers_count}}",
			"enrollment_code": "{{body.enrollment_code}}",
			"body": "{{body}}"
		}
	}
}
