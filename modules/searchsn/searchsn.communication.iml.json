{
	"url": "/devices/",
	"method": "GET",
	"qs": {
		"asset_tag": "{{parameters.assetTag}}",
		"blueprint_id": "{{parameters.blueprintId}}",
		"device_id": "{{parameters.deviceId}}",
		"device_id_lookup": "{{parameters.deviceIdLookup}}",
		"device_name": "{{parameters.deviceName}}",
		"model": "{{parameters.model}}",
		"serial_number": "{{parameters.serialNumber}}",
		"platform": "{{parameters.platform}}",
		"os_version": "{{parameters.osVersion}}",
		"user": "{{parameters.user}}",
		"user_email": "{{parameters.userEmail}}",
		"user_id": "{{parameters.userId}}",
		"user_name": "{{parameters.userName}}",
		"mac_address": "{{parameters.macAddress}}",
		"limit": "{{if(ifempty(parameters.osVersionBelow, '') != '' || ifempty(parameters.osVersionContainsAny, '') != '', 300, min(parameters.limit, 300))}}",
		"offset": "{{ifempty(parameters.offset, 0)}}"
	},
	"response": {
		"iterate": {
			"container": "{{body}}",
			"condition": "{{if(trim(ifempty(parameters.osVersionBelow, '')) == '', true, if(replace(trim(ifempty(parameters.osVersionBelow, '')), '/^[0-9]{1,9}(\\.[0-9]{1,9})*$/', '') == '' && trim(ifempty(item.os_version, '')) != '' && replace(trim(ifempty(item.os_version, '')), '/^[0-9]{1,9}(\\.[0-9]{1,9})*(\\s+\\([a-z]+\\))?$/i', '') == '', replace('000000000' + replace(replace(replace(replace(trim(ifempty(item.os_version, '')), '/\\s+\\([a-z]+\\)$/i', ''), '/(^|\\.)0+(?=[0-9])/g', '$1'), '/(\\.0)+$/', ''), '.', '.000000000'), '/[0-9]*([0-9]{9})/g', '$1') < temp.osVersionBelowKey, false)) && (length(split(ifempty(parameters.osVersionContainsAny, ''), ',')) == 0 || replace(trim(ifempty(item.os_version, '')), temp.osVersionContainsAnyPattern, '') != trim(ifempty(item.os_version, '')))}}"
		},
		"output": {
			"device_id": "{{item.device_id}}",
			"device_name": "{{item.device_name}}",
			"model": "{{item.model}}",
			"serial_number": "{{item.serial_number}}",
			"platform": "{{item.platform}}",
			"os_version": "{{item.os_version}}",
			"last_check_in": "{{item.last_check_in}}",
			"user": "{{item.user}}",
			"asset_tag": "{{item.asset_tag}}",
			"blueprint_id": "{{item.blueprint_id}}",
			"mdm_enabled": "{{item.mdm_enabled}}",
			"agent_installed": "{{item.agent_installed}}",
			"is_missing": "{{item.is_missing}}",
			"is_removed": "{{item.is_removed}}",
			"agent_version": "{{item.agent_version}}",
			"first_enrollment": "{{item.first_enrollment}}",
			"last_enrollment": "{{item.last_enrollment}}",
			"blueprint_name": "{{item.blueprint_name}}",
			"body": "{{item}}"
		},
		"limit": "{{parameters.limit}}",
		"temp": {
			"osVersionBelowKey": "{{replace('000000000' + replace(replace(replace(trim(ifempty(parameters.osVersionBelow, '')), '/(^|\\.)0+(?=[0-9])/g', '$1'), '/(\\.0)+$/', ''), '.', '.000000000'), '/[0-9]*([0-9]{9})/g', '$1')}}",
			"osVersionContainsAnyPattern": "{{'/(?:' + join(split(replace(ifempty(parameters.osVersionContainsAny, ''), '/[.*+?^\\u0024{}()|[\\]\\\\]/g', '\\$&'), ','), '|') + ')/'}}"
		}
	},
	"pagination": {
		"condition": "{{length(body) > 0}}",
		"qs": {
			"offset": "{{ifempty(parameters.offset, 0) + (pagination.page - 1) * if(ifempty(parameters.osVersionBelow, '') != '' || ifempty(parameters.osVersionContainsAny, '') != '', 300, min(parameters.limit, 300))}}"
		}
	}
}
