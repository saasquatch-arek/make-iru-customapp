[
	{
		"condition": "{{ifempty(connection.makeApiBaseUrl, '') == '' || ifempty(connection.makeApiToken, '') == '' || ifempty(parameters.scenarioId, '') == '' || length(parameters.customPropertiesToSend) == 0}}",
		"response": {
			"temp": {
				"makeCustomProperties": {}
			}
		}
	},
	{
		"condition": "{{ifempty(connection.makeApiBaseUrl, '') != '' && ifempty(connection.makeApiToken, '') != '' && ifempty(parameters.scenarioId, '') != '' && length(parameters.customPropertiesToSend) > 0}}",
		"url": "{{connection.makeApiBaseUrl}}/scenarios/{{parameters.scenarioId}}/custom-properties",
		"method": "GET",
		"headers": {
			"Authorization": "Token {{connection.makeApiToken}}",
			"Accept": "application/json"
		},
		"response": {
			"error": {
				"404": {
					"message": "Could not load Make scenario custom properties. Check Make API Base URL and that the current scenario has custom properties data."
				},
				"401": {
					"message": "Could not load Make scenario custom properties. Check the Make API token."
				},
				"403": {
					"message": "Could not load Make scenario custom properties. The Make API token needs scenarios:read for this scenario."
				},
				"message": "Could not load Make scenario custom properties. [{{statusCode}}] {{body}}"
			},
			"temp": {
				"makeCustomProperties": "{{pick(ifempty(body.customProperties, {}), parameters.customPropertiesToSend)}}"
			}
		},
		"log": {
			"sanitize": [
				"request.headers.authorization"
			]
		}
	},
	{
		"condition": "{{length(split(trim(ifempty(parameters.executionTime, '')), ':')) != 3}}",
		"response": {
			"temp": {
				"executionTimeSeconds": ""
			}
		}
	},
	{
		"condition": "{{length(split(trim(ifempty(parameters.executionTime, '')), ':')) == 3}}",
		"response": {
			"temp": {
				"executionTimeSeconds": "{{parseNumber(split(trim(ifempty(parameters.executionTime, '')), ':')[1]) * 3600 + parseNumber(split(trim(ifempty(parameters.executionTime, '')), ':')[2]) * 60 + parseNumber(split(trim(ifempty(parameters.executionTime, '')), ':')[3])}}"
			}
		}
	},
	{
		"url": "/http/make/scenario-outcome",
		"method": "POST",
		"type": "json",
		"headers": {
			"Content-Type": "application/json"
		},
		"body": {
			"timestamp": "{{parameters.timestamp}}",
			"source": "make.com",
			"event_type": "scenario_outcome",
			"outcome_type": "{{capitalize(lower(ifempty(parameters.outcomeType, 'Error')))}}",
			"severity": "{{lower(ifempty(parameters.severity, 'high'))}}",
			"scenario_name": "{{parameters.scenarioName}}",
			"scenario_id": "{{parameters.scenarioId}}",
			"scenario_url": "{{parameters.scenarioUrl}}",
			"execution_id": "{{parameters.executionId}}",
			"execution_url": "{{parameters.executionUrl}}",
			"related_itsm_task_id": "{{parameters.relatedItsmTaskId}}",
			"related_itsm_task_url": "{{parameters.relatedItsmTaskUrl}}",
			"credits_consumed": "{{parameters.creditsConsumed}}",
			"data_consumed": "{{parameters.dataConsumed}}",
			"operations_consumed": "{{parameters.operationsConsumed}}",
			"execution_time": "{{parameters.executionTime}}",
			"execution_time_seconds": "{{temp.executionTimeSeconds}}",
			"system_message": "{{parameters.systemMessage}}",
			"module_name": "{{parameters.module}}",
			"custom_attributes": "{{temp.makeCustomProperties}}",
			"details": "{{parameters.details}}"
		},
		"response": {
			"output": {
				"accepted": true,
				"statusCode": "{{statusCode}}",
				"timestamp": "{{parameters.timestamp}}",
				"source": "make.com",
				"event_type": "scenario_outcome",
				"outcome_type": "{{capitalize(lower(ifempty(parameters.outcomeType, 'Error')))}}",
				"severity": "{{lower(ifempty(parameters.severity, 'high'))}}",
				"scenario_name": "{{parameters.scenarioName}}",
				"scenario_id": "{{parameters.scenarioId}}",
				"scenario_url": "{{parameters.scenarioUrl}}",
				"execution_id": "{{parameters.executionId}}",
				"execution_url": "{{parameters.executionUrl}}",
				"related_itsm_task_id": "{{parameters.relatedItsmTaskId}}",
				"related_itsm_task_url": "{{parameters.relatedItsmTaskUrl}}",
				"credits_consumed": "{{parameters.creditsConsumed}}",
				"data_consumed": "{{parameters.dataConsumed}}",
				"operations_consumed": "{{parameters.operationsConsumed}}",
				"execution_time": "{{parameters.executionTime}}",
				"execution_time_seconds": "{{temp.executionTimeSeconds}}",
				"system_message": "{{parameters.systemMessage}}",
				"module_name": "{{parameters.module}}",
				"custom_attributes": "{{temp.makeCustomProperties}}",
				"details": "{{parameters.details}}"
			}
		}
	}
]
